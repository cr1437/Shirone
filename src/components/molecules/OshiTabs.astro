---
import { IS_EN_BUILD } from "@utils/build-locale";
import { url } from "@utils/url-utils";

interface Props {
	/** 当前所在角色页 */
	current: "miku" | "mita" | "nina" | "subaru";
}
const { current } = Astro.props;

const tabs = [
	{
		key: "miku",
		href: url("/miku/"),
		label: IS_EN_BUILD ? "Hatsune Miku" : "初音未来",
		accent: "#39C5BB",
	},
	{
		key: "nina",
		href: url("/nina/"),
		label: IS_EN_BUILD ? "Iseri Nina" : "井芹仁菜",
		accent: "#D90E2C",
	},
	{
		key: "subaru",
		href: url("/subaru/"),
		label: IS_EN_BUILD ? "Awa Subaru" : "安和昴",
		accent: "#76BD53",
	},
] as const;
---

<nav class="flex flex-wrap items-center gap-2 w-full" aria-label={IS_EN_BUILD ? "Switch character" : "切换角色"}>
	{tabs.map((t) => {
		const active = t.key === current;
		return (
			<a
				href={t.href}
				aria-current={active ? "page" : undefined}
				class="inline-flex items-center gap-2 rounded-full px-4 py-2 text-sm font-bold border transition-colors"
				style={active
					? `border-color: ${t.accent}; background: color-mix(in oklab, ${t.accent} 16%, transparent); color: var(--on-surface);`
					: "border-color: var(--outline-variant); color: var(--on-surface-variant);"}
			>
				<span
					class="inline-block h-2.5 w-2.5 rounded-full"
					style={`background: ${t.accent}; opacity: ${active ? "1" : "0.45"};`}
				></span>
				{t.label}
			</a>
		);
	})}
</nav>