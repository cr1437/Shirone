{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"headers": [
		{
			"source": "/images/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=2592000, stale-while-revalidate=86400"
				}
			]
		},
		{
			"source": "/logo/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=2592000, stale-while-revalidate=86400"
				}
			]
		},
		{
			"source": "/assets/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=2592000, stale-while-revalidate=86400"
				}
			]
		}
	]
}
